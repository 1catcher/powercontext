# MiniMax SDD 上下文模块环境变量示例（占位值，不提交真实凭据）
#
# 复制为 .env 后填写，或在 shell 中直接 export：
#   cp .env.example .env
#
# MiniMax（必填，用于在线生成代码修改；离线重放时可不填）
MINIMAX_API_KEY=replace-me
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# PowerContext 服务地址（run.sh 自动生成 minimax/.env 并启动服务，通常无需修改）
POWERCONTEXT_SERVER_URL=http://127.0.0.1:8600
